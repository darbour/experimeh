{
  "name": "@experimeh/browser",
  "version": "1.0.0",
  "description": "Lightweight browser JavaScript SDK for Experimeh feature flag experimentation",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "experiments",
    "ab-testing",
    "feature-flags",
    "experimentation",
    "browser",
    "sdk"
  ],
  "author": "Experimeh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/experimeh/experimeh.git",
    "directory": "sdks/browser-js"
  },
  "bugs": {
    "url": "https://github.com/experimeh/experimeh/issues"
  },
  "homepage": "https://github.com/experimeh/experimeh/tree/main/sdks/browser-js#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.9.4",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=14"
  }
}
