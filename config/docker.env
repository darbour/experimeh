# ==========================================
# Docker Environment Configuration
# ==========================================
# This file contains environment variables for docker-compose
# Copy this to .env in the project root and customize for your environment
# ==========================================

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=experimeh
POSTGRES_USER=experimeh
POSTGRES_PASSWORD=changeme_secure_password_here

# ==========================================
# Redis Configuration
# ==========================================
# Redis cache settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Kafka Configuration
# ==========================================
# Event streaming settings
KAFKA_BROKERS=kafka:29092
KAFKA_PORT=9092
KAFKA_CLIENT_ID=experimeh
KAFKA_GROUP_ID=experimeh-group

# ==========================================
# API Configuration
# ==========================================
# CORS settings
CORS_ORIGIN=*

# API key authentication
# Comma-separated list of valid API keys
VALID_API_KEYS=api_key_1,api_key_2,api_key_3

# Admin API keys for privileged operations
ADMIN_API_KEYS=admin_key_1,admin_key_2

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ==========================================
# Application Configuration
# ==========================================
# Cache TTL in seconds (default: 1 hour)
ASSIGNMENT_CACHE_TTL=3600

# Maximum number of concurrent experiments per user
MAX_CONCURRENT_EXPERIMENTS=100

# Default statistical confidence level (0-1)
DEFAULT_CONFIDENCE_LEVEL=0.95

# ==========================================
# Migration Configuration
# ==========================================
# Set to true to skip database migrations on startup
SKIP_MIGRATIONS=false

# ==========================================
# Health Check Configuration
# ==========================================
# Maximum retries for waiting on dependencies
MAX_RETRIES=30

# Retry interval in seconds
RETRY_INTERVAL=2

# ==========================================
# Security Configuration
# ==========================================
# Enable/disable security features
HELMET_ENABLED=true

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ==========================================
# Performance Configuration
# ==========================================
# Maximum request body size
MAX_REQUEST_SIZE=10mb

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis connection pool
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# ==========================================
# Monitoring Configuration
# ==========================================
# Enable metrics collection
METRICS_ENABLED=true

# Metrics port (if using separate metrics server)
METRICS_PORT=9090

# Enable request logging
REQUEST_LOGGING=true

# ==========================================
# Development Configuration
# ==========================================
# Only for development/testing environments
# DEBUG=experimeh:*
# ENABLE_SWAGGER=true
# ENABLE_GRAPHQL_PLAYGROUND=true
